{
  "name": "laurel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Generador de resultados de torneos: carga logs de partidas y exporta una imagen lista para compartir. 100% client-side.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "contact-sheet": "vite --open contact-sheet.html",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/cutive-mono": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/space-grotesk": "^5.0.0",
    "@fontsource/syne": "^5.0.0",
    "@fontsource/teko": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "html-to-image": "^1.11.11",
    "idb-keyval": "^6.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "es-abstract": "^1.23.9",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
